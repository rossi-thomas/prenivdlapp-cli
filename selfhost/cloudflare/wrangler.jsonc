{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prenivdl-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "max_instances": 3,
      "class_name": "PrenivdlContainer",
      // Built and pushed to GHCR by .github/workflows/container-image.yml
      // (no local Docker needed): ghcr.io/rossi023/prenivdl/prenivdl-api:latest
      "image": "ghcr.io/rossi023/prenivdl/prenivdl-api:latest",
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRENIVDL",
        "class_name": "PrenivdlContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrenivdlContainer"]
    }
  ]
}
