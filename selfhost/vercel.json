{
  "version": 2,
  "functions": {
    "api/download.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/download"
    },
    {
      "source": "/health",
      "destination": "/api/download"
    },
    {
      "source": "/api",
      "destination": "/api/download"
    },
    {
      "source": "/api/:platform((?!^download$).*)",
      "destination": "/api/download?platform=:platform"
    }
  ]
}