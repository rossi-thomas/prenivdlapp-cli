{
  "version": 2,
  "functions": {
    "api/download.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/captcha/verify",
      "destination": "/api/download?platform=captcha_verify"
    },
    {
      "source": "/api/captcha",
      "destination": "/api/download?platform=captcha"
    },
    {
      "source": "/health",
      "destination": "/api/download"
    },
    {
      "source": "/api",
      "destination": "/api/download"
    },
    {
      "source": "/api/:platform((?!^download$).*)",
      "destination": "/api/download?platform=:platform"
    }
  ]
}